{
  "name": "@dbmcp/client",
  "private": true,
  "version": "1.0.14",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:desktop": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "preview:ui": "vite --host 127.0.0.1 --mode ui-preview",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src",
    "tauri": "tauri",
    "generate:api": "openapi-typescript ../docs/openapi.json -o src/lib/contract.ts"
  },
  "dependencies": {
    "@headless-tree/core": "1.8.0",
    "@headless-tree/react": "1.8.0",
    "@hookform/resolvers": "5.2.2",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.90.5",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-autostart": "2.5.1",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-notification": "2.8.0",
    "lucide-react": "0.552.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "7.65.0",
    "semver": "7.8.6",
    "sonner": "2.0.7",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/semver": "7.7.1",
    "@vitejs/plugin-react": "5.1.0",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "openapi-typescript": "7.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "7.2.2"
  },
  "license": "MIT"
}
